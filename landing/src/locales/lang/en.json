                    "questions": [
                        {
                            "question": "Which payment methods do you accept?",
                            "answer": "We accept credit and debit cards, bank transfers and cash payments at our office. An invoice is generated automatically for every payment."
                        },
                        {
                            "question": "What currency are the prices in?",
                            "answer": "All prices are in Moroccan dirham (MAD) and exclude local taxes where applicable."
                        },
                        {
                            "question": "Do you offer refunds?",
                            "answer": "Monthly plans are non-refundable. For 6-month and annual plans, contact us within 14 days of payment for a prorated refund."
                        },
                        {
                            "question": "How do I get an invoice?",
                            "answer": "Every payment produces a downloadable invoice in your billing section, ready to hand to your accountant."
                        }
