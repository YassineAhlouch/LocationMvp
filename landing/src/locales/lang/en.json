                        {
                            "question": "What is included in the subscription?",
                            "answer": "Every plan includes the full platform: reservations, fleet, customers, contracts, payments, invoices, reports, team roles and multi-language support. There are no hidden modules."
                        },
                        {
                            "question": "Do I need to install anything?",
                            "answer": "No. Double V Drive runs in your browser on desktop, tablet and phone, and your data is stored securely in the cloud."
                        },
                        {
                            "question": "Can I change my billing period later?",
                            "answer": "Yes. You can move from monthly to 6 months or annual at any time. The remaining balance is applied to your new period."
                        },
                        {
                            "question": "Is there a free trial?",
                            "answer": "Yes, we offer a 14-day free trial so you can test the platform with your own fleet before subscribing."
                        },
                        {
                            "question": "Can I cancel at any time?",
                            "answer": "Yes. Monthly subscriptions can be cancelled whenever you want and stay active until the end of the paid period."
                        }
